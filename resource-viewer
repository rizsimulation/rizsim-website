<script type="module">


import {
createClient
}
from
"https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm";


import * as pdfjsLib
from
"https://cdn.jsdelivr.net/npm/pdfjs-dist@4.10.38/build/pdf.min.mjs";


pdfjsLib.GlobalWorkerOptions.workerSrc =
"https://cdn.jsdelivr.net/npm/pdfjs-dist@4.10.38/build/pdf.worker.min.mjs";



/* ============================================================
   SUPABASE
   ============================================================ */

const SUPABASE_URL =
"https://rvmumpvtvjvvuyimeybc.supabase.co";


const SUPABASE_PUBLISHABLE_KEY =
"sb_publishable_wufSxfg90bb4R6XarScaJQ_Dl5wlmtf";


const supabase =
createClient(
SUPABASE_URL,
SUPABASE_PUBLISHABLE_KEY
);



/* ============================================================
   STATE
   ============================================================ */

const params =
new URLSearchParams(
window.location.search
);


const productId =
params.get(
"resource"
);


let currentUser =
null;


let currentProfile =
null;


let resourceContext =
null;


let protectedBytes =
null;


let pdfDocument =
null;


let currentPage =
1;


let zoomMultiplier =
1;


let currentRenderTask =
null;


let revalidationTimer =
null;



/* ============================================================
   ELEMENTS
   ============================================================ */

const canvas =
document.getElementById(
"pageCanvas"
);


const documentShell =
document.getElementById(
"documentShell"
);


const viewerStatus =
document.getElementById(
"viewerStatus"
);


const viewerToolbar =
document.getElementById(
"viewerToolbar"
);


const loadingOverlay =
document.getElementById(
"loadingOverlay"
);



/* ============================================================
   HELPERS
   ============================================================ */

function showLoading(
text =
"Opening protected resource…"
) {

document.getElementById(
"loadingText"
).textContent =
text;


loadingOverlay.classList.add(
"show"
);

}


function hideLoading() {

loadingOverlay.classList.remove(
"show"
);

}


function showStatus(
title,
message,
isError =
false
) {

canvas.hidden =
true;


viewerToolbar.hidden =
true;


viewerStatus.hidden =
false;


viewerStatus.classList.toggle(
"error",
isError
);


document.getElementById(
"statusTitle"
).textContent =
title;


document.getElementById(
"statusText"
).textContent =
message;

}


function formatFileSize(
bytes
) {

const size =
Number(
bytes
||
0
);


if(!size) {

return "";

}


if(
size <
1024 * 1024
) {

return (
Math.round(
size /
1024
)
+
" KB"
);

}


return (
(
size /
1024 /
1024
)
.toFixed(
2
)
+
" MB"
);

}


function getWatermarkIdentity() {

return (

currentProfile?.display_name

||

currentUser?.email

||

"Authorized RizSim User"

);

}



/* ============================================================
   AUTHENTICATION
   ============================================================ */

async function loadUser() {

const {
data:
sessionData
} =

await supabase
.auth
.getSession();


if(
!sessionData?.session
) {

showStatus(
"Sign-in required",
"Please return to RizSim and sign in before opening this protected resource.",
true
);

return false;

}


currentUser =
sessionData.session.user;


const {
data:
profile
} =

await supabase

.from(
"profiles"
)

.select(
"display_name"
)

.eq(
"id",
currentUser.id
)

.maybeSingle();


currentProfile =
profile
||
null;


return true;

}



/* ============================================================
   AUTHORIZATION CONTEXT
   ============================================================ */

async function loadResourceContext() {

const {
data,
error
} =

await supabase.rpc(
"get_rizsim_resource_view_context",
{

p_product_id:
productId

}
);


if(
error
||
!data?.length
) {

showStatus(
"Access unavailable",
error?.message
||
"RizSim could not authorize this resource.",
true
);

return false;

}


resourceContext =
data[0];


document.getElementById(
"resourceTitle"
).textContent =
resourceContext.title
||
"RizSim Resource";


const metaParts = [

resourceContext.product_type ===
"ebook"
?
"eBook"
:
"Learning Material",

resourceContext.file_name,

formatFileSize(
resourceContext.file_size
)

]
.filter(
Boolean
);


document.getElementById(
"resourceMeta"
).textContent =
metaParts.join(
" · "
);


return true;

}



/* ============================================================
   SECURE STREAM
   ============================================================ */

async function loadProtectedFile() {

const {
data:
sessionData
} =

await supabase
.auth
.getSession();


const accessToken =
sessionData?.session?.access_token;


if(!accessToken) {

throw new Error(
"Your RizSim session has expired."
);

}


const response =

await fetch(

SUPABASE_URL
+
"/functions/v1/rizsim-resource-stream",

{

method:
"POST",

headers: {

"Authorization":
"Bearer "
+
accessToken,

"Content-Type":
"application/json"

},

body:
JSON.stringify(
{

product_id:
productId

}
),

cache:
"no-store"

}

);


if(!response.ok) {

let message =
"RizSim could not retrieve this protected resource.";


try {

const body =
await response.json();


if(
body?.error
) {

message =
body.error;

}

}
catch {
}


throw new Error(
message
);

}


protectedBytes =
await response.arrayBuffer();

}



/* ============================================================
   WATERMARK
   ============================================================ */

function applyWatermark(
context,
width,
height
) {

const identity =
getWatermarkIdentity();


const stamp =

identity

+
"  •  RizSim Protected  •  "

+
new Date()
.toLocaleString();


context.save();


context.globalAlpha =
0.10;


context.fillStyle =
"#126d75";


const fontSize =
Math.max(
14,
Math.min(
26,
width /
42
)
);


context.font =
"700 "
+
fontSize
+
"px Arial";


context.textAlign =
"center";


context.textBaseline =
"middle";


context.translate(
width /
2,
height /
2
);


context.rotate(
-Math.PI /
6
);


const horizontalStep =
Math.max(
270,
width /
3
);


const verticalStep =
Math.max(
160,
height /
4
);


for(
let y =
-height;
y <=
height;
y +=
verticalStep
) {

for(
let x =
-width;
x <=
width;
x +=
horizontalStep
) {

context.fillText(
stamp,
x,
y
);

}

}


context.restore();

}



/* ============================================================
   PDF
   ============================================================ */

async function loadPdf() {

const bytes =
new Uint8Array(
protectedBytes
);


pdfDocument =

await pdfjsLib
.getDocument(
{

data:
bytes,

disableFontFace:
false,

isEvalSupported:
false

}
)
.promise;


currentPage =
1;


viewerToolbar.hidden =
false;


viewerStatus.hidden =
true;


canvas.hidden =
false;


await renderPdfPage();

}


async function renderPdfPage() {

if(!pdfDocument) {

return;

}


if(currentRenderTask) {

try {

currentRenderTask.cancel();

}
catch {
}

}


showLoading(
"Rendering protected page…"
);


try {


const page =
await pdfDocument.getPage(
currentPage
);


const baseViewport =
page.getViewport(
{

scale:
1

}
);


const shellWidth =
Math.max(
320,
documentShell.clientWidth -
60
);


const fitScale =
Math.min(
1.6,
shellWidth /
baseViewport.width
);


const scale =

fitScale
*
zoomMultiplier;


const viewport =
page.getViewport(
{

scale

}
);


canvas.width =
Math.ceil(
viewport.width
);


canvas.height =
Math.ceil(
viewport.height
);


const context =
canvas.getContext(
"2d",
{

alpha:
false

}
);


context.fillStyle =
"#ffffff";


context.fillRect(
0,
0,
canvas.width,
canvas.height
);


currentRenderTask =

page.render(
{

canvasContext:
context,

viewport

}
);


await currentRenderTask.promise;


applyWatermark(
context,
canvas.width,
canvas.height
);


document.getElementById(
"pageIndicator"
).textContent =

"Page "
+
currentPage
+
" of "
+
pdfDocument.numPages;


document.getElementById(
"zoomIndicator"
).textContent =

Math.round(
zoomMultiplier *
100
)
+
"%";


document.getElementById(
"previousPage"
).disabled =
currentPage <=
1;


document.getElementById(
"nextPage"
).disabled =
currentPage >=
pdfDocument.numPages;


documentShell.scrollTop =
0;


}
catch(error) {


if(
error?.name !==
"RenderingCancelledException"
) {

console.error(
error
);


showStatus(
"Unable to render page",
"RizSim could not display this page.",
true
);

}


}
finally {

currentRenderTask =
null;


hideLoading();

}

}



/* ============================================================
   IMAGE VIEWER
   ============================================================ */

async function renderProtectedImage() {

showLoading(
"Rendering protected image…"
);


try {


const blob =
new Blob(
[
protectedBytes
],
{

type:
resourceContext.mime_type

}
);


const url =
URL.createObjectURL(
blob
);


const image =
new Image();


await new Promise(
(resolve,reject) => {

image.onload =
resolve;

image.onerror =
reject;

image.src =
url;

}
);


const shellWidth =
Math.max(
320,
documentShell.clientWidth -
60
);


const naturalWidth =
image.naturalWidth;


const naturalHeight =
image.naturalHeight;


const fitScale =
Math.min(
1,
shellWidth /
naturalWidth
);


const scale =
fitScale *
zoomMultiplier;


canvas.width =
Math.round(
naturalWidth *
scale
);


canvas.height =
Math.round(
naturalHeight *
scale
);


const context =
canvas.getContext(
"2d",
{

alpha:
false

}
);


context.fillStyle =
"#ffffff";


context.fillRect(
0,
0,
canvas.width,
canvas.height
);


context.drawImage(
image,
0,
0,
canvas.width,
canvas.height
);


applyWatermark(
context,
canvas.width,
canvas.height
);


URL.revokeObjectURL(
url
);


viewerStatus.hidden =
true;


viewerToolbar.hidden =
false;


canvas.hidden =
false;


document.getElementById(
"pageIndicator"
).textContent =
"Image";


document.getElementById(
"previousPage"
).disabled =
true;


document.getElementById(
"nextPage"
).disabled =
true;


document.getElementById(
"zoomIndicator"
).textContent =

Math.round(
zoomMultiplier *
100
)
+
"%";


}
catch(error) {

console.error(
error
);


showStatus(
"Unable to display resource",
"RizSim could not render this protected image.",
true
);

}
finally {

hideLoading();

}

}



/* ============================================================
   FILE TYPE ROUTING
   ============================================================ */

async function renderResource() {

const mime =
String(
resourceContext?.mime_type
||
""
)
.toLowerCase();


if(
mime ===
"application/pdf"
) {

await loadPdf();

return;

}


if(
mime ===
"image/png"
||
mime ===
"image/jpeg"
) {

await renderProtectedImage();

return;

}


showStatus(
"Protected conversion required",

"This file type cannot yet be shown securely in the RizSim Viewer. Convert it to protected PDF before learner publication.",

true
);

}



/* ============================================================
   REVALIDATE ACCESS
   ============================================================ */

async function revalidateAccess() {

const {
data,
error
} =

await supabase.rpc(
"get_rizsim_resource_view_context",
{

p_product_id:
productId

}
);


if(
error
||
!data?.length
) {

protectedBytes =
null;


pdfDocument =
null;


canvas.width =
1;


canvas.height =
1;


showStatus(
"Access ended",
"Your authorization for this RizSim resource is no longer active.",
true
);


if(
revalidationTimer
) {

clearInterval(
revalidationTimer
);

}

}

}



/* ============================================================
   INITIALIZE
   ============================================================ */

async function initialize() {

if(!productId) {

showStatus(
"Resource not specified",
"No RizSim resource identifier was provided.",
true
);

return;

}


showLoading(
"Checking RizSim authorization…"
);


try {


const authenticated =
await loadUser();


if(!authenticated) {

return;

}


const authorized =
await loadResourceContext();


if(!authorized) {

return;

}


showLoading(
"Opening protected resource…"
);


await loadProtectedFile();


await renderResource();


revalidationTimer =

setInterval(
revalidateAccess,
60000
);


}
catch(error) {

console.error(
error
);


showStatus(
"Resource unavailable",
error?.message
||
"RizSim could not open this protected resource.",
true
);

}
finally {

hideLoading();

}

}



/* ============================================================
   CONTROLS
   ============================================================ */

document
.getElementById(
"previousPage"
)
.addEventListener(
"click",
async () => {

if(
!pdfDocument
||
currentPage <=
1
) {

return;

}


currentPage -=
1;


await renderPdfPage();

}
);


document
.getElementById(
"nextPage"
)
.addEventListener(
"click",
async () => {

if(
!pdfDocument
||
currentPage >=
pdfDocument.numPages
) {

return;

}


currentPage +=
1;


await renderPdfPage();

}
);


document
.getElementById(
"zoomIn"
)
.addEventListener(
"click",
async () => {

zoomMultiplier =
Math.min(
2.2,
zoomMultiplier +
0.15
);


if(pdfDocument) {

await renderPdfPage();

}
else {

await renderProtectedImage();

}

}
);


document
.getElementById(
"zoomOut"
)
.addEventListener(
"click",
async () => {

zoomMultiplier =
Math.max(
0.65,
zoomMultiplier -
0.15
);


if(pdfDocument) {

await renderPdfPage();

}
else {

await renderProtectedImage();

}

}
);


document
.getElementById(
"fitPage"
)
.addEventListener(
"click",
async () => {

zoomMultiplier =
1;


if(pdfDocument) {

await renderPdfPage();

}
else {

await renderProtectedImage();

}

}
);


document
.getElementById(
"backButton"
)
.addEventListener(
"click",
() => {

if(
window.history.length >
1
) {

window.history.back();

}
else {

window.location.href =
"/";

}

}
);



/* ============================================================
   SECURITY DETERRENTS
   ============================================================ */

document.addEventListener(
"contextmenu",
event => {

event.preventDefault();

}
);


document.addEventListener(
"copy",
event => {

event.preventDefault();

}
);


document.addEventListener(
"cut",
event => {

event.preventDefault();

}
);


document.addEventListener(
"dragstart",
event => {

event.preventDefault();

}
);


document.addEventListener(
"keydown",
event => {


const key =
String(
event.key
)
.toLowerCase();


if(
(
event.ctrlKey
||
event.metaKey
)
&&
[
"s",
"p",
"c",
"u"
].includes(
key
)
) {

event.preventDefault();

return;

}


if(
key ===
"arrowleft"
&&
pdfDocument
&&
currentPage >
1
) {

currentPage -=
1;

renderPdfPage();

}


if(
key ===
"arrowright"
&&
pdfDocument
&&
currentPage <
pdfDocument.numPages
) {

currentPage +=
1;

renderPdfPage();

}

}
);



/* ============================================================
   WINDOW RESIZE
   ============================================================ */

let resizeTimer =
null;


window.addEventListener(
"resize",
() => {

clearTimeout(
resizeTimer
);


resizeTimer =

setTimeout(
() => {

if(pdfDocument) {

renderPdfPage();

}

},
250
);

}
);



/* ============================================================
   START
   ============================================================ */

initialize();


</script>

